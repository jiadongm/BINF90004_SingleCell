# Data comes from Zenodo (10.5281/zenodo.21803240), never from git.
data/

# Build output in the source folders. Anchored with a leading slash so these
# rules do NOT apply to docs/ — the published site needs its *_files/
# directories, and git cannot re-include files inside an ignored directory.
/practicals/*.html
/practicals/*_files/
/practicals/*_cache/
/slides/*.html
/slides/*_files/
/slides/*_cache/

# R
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj

# OS
.DS_Store
Thumbs.db
